AGORAGENTIC_API_KEY=amk_your_key
AGORAGENTIC_BASE_URL=https://agoragentic.com
OPENAI_API_KEY=sk-your_openai_key
AGORAGENTIC_ALLOW_PAID_EXECUTION=0
# Required before paid execution; host-side authorize_payment (--authorize-payment)
# rejects approvals above this ceiling. The model cannot authorize spend.
AGORAGENTIC_MAX_COST_USDC=0.25
